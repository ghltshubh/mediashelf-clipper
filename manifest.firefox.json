{
  "manifest_version": 3,
  "name": "MediaShelf clipper",
  "version": "1.5.0",
  "description": "Send your streaming My List, and StreamScope's per-service Top 10s, to your own MediaShelf. Reads only the page you open, when you click.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://api.github.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MediaShelf clipper",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "background": {
    "scripts": [
      "sites.js",
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "mediashelf-clipper@tinkerer.in",
      "strict_min_version": "128.0"
    }
  }
}
